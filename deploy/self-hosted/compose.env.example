# Copy reviewed values into the external local secrets file. Never place real values here.
ALTIVY_PUBLIC_HOST=localhost
ALTIVY_PUBLIC_ORIGIN=https://localhost:7443/notes
ALTIVY_TLS_CA_PATH=C:/path/outside/repository/rootCA.pem
ALTIVY_API_TLS_CERTIFICATE_PATH=C:/path/outside/repository/api.crt
ALTIVY_API_TLS_PRIVATE_KEY_PATH=C:/path/outside/repository/api.key
ALTIVY_KEYCLOAK_AUTHORITY=https://identity.example.test/realms/altivy
ALTIVY_BFF_CLIENT_SECRET=REPLACE_WITH_EXTERNAL_SECRET
ALTIVY_DATA_PROTECTION_CERTIFICATE_PASSWORD=REPLACE_WITH_EXTERNAL_SECRET
IDENTITY_GATEWAY_IP=REPLACE_WITH_CURRENT_IDENTITY_GLOBAL_GATEWAY_IP
ALTIVY_DATA_ROOT=C:/path/outside/repository/altivy-data
ALTIVY_CONFIG_ROOT=C:/path/outside/repository/altivy-config
ALTIVY_POSTGRES_RUNTIME_CONNECTION_STRING=Host=postgres;Database=altivy;Username=altivy_runtime;Password=REPLACE_WITH_EXTERNAL_SECRET
ALTIVY_POSTGRES_MIGRATOR_CONNECTION_STRING=Host=postgres;Database=altivy;Username=altivy_migrator;Password=REPLACE_WITH_EXTERNAL_SECRET
ALTIVY_BACKEND_VERSION=0.1.0
ALTIVY_WEB_VERSION=0.1.0
ALTIVY_WEB_IMAGE=altivy-web:0.1.0
ALTIVY_BFF_IMAGE=altivy-bff:0.1.0
ALTIVY_API_IMAGE=altivy-api:0.1.0
ALTIVY_WORKER_IMAGE=altivy-worker:0.1.0
ALTIVY_MIGRATIONS_IMAGE=altivy-migrations:0.1.0
ALTIVY_SMTP_HOST=smtp.example.test
ALTIVY_SMTP_PORT=587
ALTIVY_SMTP_USERNAME=REPLACE_WITH_EXTERNAL_VALUE
ALTIVY_SMTP_PASSWORD=REPLACE_WITH_EXTERNAL_SECRET
ALTIVY_SMTP_FROM=altivy@example.test
ALTIVY_SMTP_TO=operator@example.test
