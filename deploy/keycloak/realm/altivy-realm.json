{
    "realm": "altivy",
    "displayName": "Nodra",
    "enabled": true,
    "sslRequired": "external",
    "registrationAllowed": false,
    "registrationEmailAsUsername": false,
    "rememberMe": false,
    "verifyEmail": true,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "resetPasswordAllowed": false,
    "editUsernameAllowed": false,
    "bruteForceProtected": true,
    "permanentLockout": false,
    "failureFactor": 5,
    "waitIncrementSeconds": 60,
    "quickLoginCheckMilliSeconds": 1000,
    "minimumQuickLoginWaitSeconds": 60,
    "maxFailureWaitSeconds": 900,
    "maxDeltaTimeSeconds": 43200,
    "passwordPolicy": "length(14) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",
    "ssoSessionIdleTimeout": 1800,
    "ssoSessionMaxLifespan": 36000,
    "clientSessionIdleTimeout": 900,
    "clientSessionMaxLifespan": 28800,
    "accessTokenLifespan": 300,
    "accessCodeLifespan": 60,
    "accessCodeLifespanLogin": 300,
    "accessCodeLifespanUserAction": 300,
    "actionTokenGeneratedByAdminLifespan": 43200,
    "revokeRefreshToken": false,
    "eventsEnabled": true,
    "eventsExpiration": 2592000,
    "eventsListeners": [
        "jboss-logging"
    ],
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": false,
    "loginTheme": "altivy",
    "roles": {
        "client": {
            "altivy-api": [
                {
                    "name": "Owner",
                    "description": "Administra os recursos Altivy explicitamente autorizados."
                },
                {
                    "name": "Editor",
                    "description": "Le e altera os recursos Altivy explicitamente autorizados."
                },
                {
                    "name": "Reader",
                    "description": "Le os recursos Altivy explicitamente autorizados."
                }
            ]
        }
    },
    "clients": [
        {
            "clientId": "altivy-lab",
            "name": "Altivy Lab",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "redirectUris": [
                "http://localhost:8080/"
            ],
            "webOrigins": [
                "http://localhost:8080"
            ]
        },
        {
            "clientId": "altivy-api",
            "name": "Altivy API",
            "enabled": true,
            "publicClient": false,
            "bearerOnly": false,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": true,
            "authorizationServicesEnabled": true,
            "protocol": "openid-connect"
        },
        {
            "clientId": "altivy-authorization-spike",
            "name": "Altivy Authorization Spike",
            "enabled": true,
            "publicClient": true,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "redirectUris": [
                "http://127.0.0.1:8765/callback/"
            ],
            "webOrigins": [],
            "attributes": {
                "pkce.code.challenge.method": "S256",
                "oauth2.device.authorization.grant.enabled": "false"
            },
            "protocol": "openid-connect"
        },
        {
            "clientId": "altivy-bff",
            "name": "Altivy BFF",
            "enabled": true,
            "publicClient": false,
            "standardFlowEnabled": true,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "serviceAccountsEnabled": false,
            "rootUrl": "https://localhost:7443",
            "baseUrl": "https://localhost:7443/",
            "redirectUris": [
                "https://localhost:7443/signin-oidc"
            ],
            "attributes": {
                "post.logout.redirect.uris": "https://localhost:7443/signout-callback-oidc",
                "pkce.code.challenge.method": "S256"
            },
            "protocol": "openid-connect"
        }
    ],
    "groups": [
        {
            "name": "altivy",
            "subGroups": [
                {
                    "name": "owners",
                    "clientRoles": {
                        "altivy-api": [
                            "Owner"
                        ]
                    }
                },
                {
                    "name": "editors",
                    "clientRoles": {
                        "altivy-api": [
                            "Editor"
                        ]
                    }
                },
                {
                    "name": "readers",
                    "clientRoles": {
                        "altivy-api": [
                            "Reader"
                        ]
                    }
                }
            ]
        }
    ]
}