{
    "Authentication": {
        "Keycloak": {
            "Authority": "http://localhost:8080/realms/altivy",
            "ClientId": "altivy-bff",
            "ClientSecret": ""
        }
    },
    "Security": {
        "DataProtectionKeysPath": ".data-protection-keys",
        "AllowedOrigins": [
            "https://localhost:7443"
        ],
        "TrustedProxies": [
            "127.0.0.1",
            "::1"
        ]
    },
    "Downstream": {
        "Api": {
            "BaseUrl": "http://localhost:5080"
        }
    },
    "Bff": {
        "DataProtectionApplicationName": "Altivy.Bff",
        "MemoryCacheSizeLimit": 10000,
        "LoginRateLimitPermitLimit": 10,
        "LoginRateLimitWindowSeconds": 60,
        "LoginRateLimitQueueLimit": 0,
        "TokenRefreshTimeoutSeconds": 10,
        "TokenRefreshMaxResponseContentBufferSize": 65536,
        "KeycloakDiscoveryTimeoutSeconds": 3,
        "DownstreamApiTimeoutSeconds": 30,
        "AntiforgeryCookieName": "__Host-Altivy.Antiforgery",
        "AntiforgeryHeaderName": "X-Altivy-Antiforgery"
    },
    "OpenTelemetry": {
        "OtlpEndpoint": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "localhost"
}