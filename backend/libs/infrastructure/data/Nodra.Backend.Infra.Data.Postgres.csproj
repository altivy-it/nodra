<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Nodra.Backend.Infra.Data.Postgres</RootNamespace>
        <UserSecretsId>Altivy.Notes</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
        <PackageReference Include="System.Security.Cryptography.Xml" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../application/Nodra.Backend.Application.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Migrations/Script/**/*.sql" />
    </ItemGroup>
</Project>
